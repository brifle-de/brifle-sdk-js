{
  "name": "@brifle/brifle-sdk",
  "version": "0.3.3",
  "description": "The JavaScript SDK to interact with the API of Brifle",
  "files": [
    "dist",
    "README",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "spec:pull": "node scripts/pull-spec.mjs",
    "generate": "openapi-ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "jest test/unit",
    "test:live": "jest --setupFiles dotenv/config test/live",
    "build:types": "tsc --project tsconfig.types.json",
    "build": "npm run build:types && rollup -c",
    "rollup": "npm run build",
    "api:check": "npm run build:types && api-extractor run",
    "api:update": "npm run build:types && api-extractor run --local",
    "prepack": "npm run build"
  },
  "keywords": [
    "Brifle"
  ],
  "author": "Brifle GmbH",
  "license": "MIT",
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.4.3",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.5.0",
    "rollup": "^4.40.0",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brifle-de/brifle-sdk-js.git"
  },
  "engines": {
    "node": ">=18"
  }
}
